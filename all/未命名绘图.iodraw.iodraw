        <mxCell id="v8n_ULN4s5QUdkia3UFk-36" value="&lt;span style=&quot;background-color: rgb(255, 217, 102);&quot;&gt;责任人：运营：Oria&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 217, 102);&quot;&gt;产品：Ivy&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 217, 102);&quot;&gt;品质：Luis&lt;/span&gt;&lt;div&gt;&lt;p data-pm-slice=&quot;1 1 [&amp;quot;ordered_list&amp;quot;,{&amp;quot;spread&amp;quot;:true,&amp;quot;startingNumber&amp;quot;:1,&amp;quot;start&amp;quot;:110,&amp;quot;end&amp;quot;:1075},&amp;quot;regular_list_item&amp;quot;,{&amp;quot;start&amp;quot;:110,&amp;quot;end&amp;quot;:181}]&quot;&gt;职责：提交问题描述、客户反馈、相关数据及影响范围。&lt;/p&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
