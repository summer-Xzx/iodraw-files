        <mxCell id="v8n_ULN4s5QUdkia3UFk-54" value="评估是否需要小批量验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
