        <mxCell id="v8n_ULN4s5QUdkia3UFk-44" value="&lt;p data-pm-slice=&quot;1 1 [&amp;quot;ordered_list&amp;quot;,{&amp;quot;spread&amp;quot;:true,&amp;quot;startingNumber&amp;quot;:1,&amp;quot;start&amp;quot;:110,&amp;quot;end&amp;quot;:1075},&amp;quot;regular_list_item&amp;quot;,{&amp;quot;start&amp;quot;:965,&amp;quot;end&amp;quot;:1075}]&quot;&gt;关单组织人：Ryder。&lt;br&gt;实施确认：Luis或相应专业负责人。&lt;br&gt;效果确认：对应链接运营。&lt;br&gt;职责：确认实施证据和效果数据满足验收要求，记录结论并关闭事项。&lt;/p&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="885" y="1420" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v8n_ULN4s5QUdkia3UFk-45" value="&lt;p data-pm-slice=&quot;1 3 []&quot;&gt;责任分工原则&lt;/p&gt;&lt;ol data-spread=&quot;false&quot; start=&quot;1&quot;&gt;&lt;li&gt;&lt;p&gt;Ryder负责流程统筹、跨部门协调、节点跟进和组织关单。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;每项问题只指定一名主责人，跨专业问题也必须明确牵头人。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;采购负责供应商执行协调，以及费用、订单、交期和正式生产切换确认。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;产品、采购、计划物流及对应链接运营，均需落实到具体姓名。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;“已实施”与“验证有效”分开记录，效果未经验证不得按改善成功关闭。&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="880" y="1574" width="450" height="180" as="geometry" />
